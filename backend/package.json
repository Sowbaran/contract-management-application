{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "biome format ./src --write",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint ./src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "commitlint": "commitlint --edit",
    "commitizen": "exec < /dev/tty && git cz --hook || true",
    "prepare": "husky",
    "migrate:up": "npx ts-node -r tsconfig-paths/register libs/common/src/database/migrate.ts up",
    "migrate:down": "npx ts-node -r tsconfig-paths/register libs/common/src/database/migrate.ts down",
    "migrate:down:all": "npx ts-node -r tsconfig-paths/register libs/common/src/database/migrate.ts downAll",
    "migrate:status": "npx ts-node -r tsconfig-paths/register libs/common/src/database/migrate.ts status",
    "generate:migration": "npx migrate-mongo create",
    "migrate:generate": "npm run generate:migration --"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.609.0",
    "@aws-sdk/client-secrets-manager": "^3.535.0",
    "@aws-sdk/credential-providers": "^3.609.0",
    "@aws-sdk/lib-storage": "^3.537.0",
    "@aws-sdk/s3-request-presigner": "^3.609.0",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.2",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/mongoose": "^10.0.4",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.2",
    "@nestjs/swagger": "^7.4.1",
    "@scalar/nestjs-api-reference": "^0.3.150",
    "@types/migrate-mongo": "^10.0.5",
    "@types/passport-jwt": "^4.0.1",
    "@vendia/serverless-express": "^4.12.6",
    "aws-lambda": "^1.0.7",
    "aws-sdk": "^2.1574.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "dotenv": "^16.4.4",
    "express": "^4.18.3",
    "imports-loader": "^5.0.0",
    "json-2-csv": "^5.5.8",
    "jwks-rsa": "^3.2.0",
    "mongodb": "^6.15.0",
    "mongoose": "^8.2.0",
    "multer-s3": "^3.0.1",
    "nestjs-pino": "^4.1.0",
    "passport": "^0.7.0",
    "passport-auth0": "^1.0.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.16.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.1",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.3.3",
    "@types/aws-lambda": "^8.10.133",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^20.16.5",
    "@types/passport-auth0": "^1.0.9",
    "@types/pdfkit": "^0.13.9",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.0.7",
    "jest": "^29.5.0",
    "migrate-mongo": "^12.1.3",
    "serverless-offline": "^13.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1"
    }
  }
}
