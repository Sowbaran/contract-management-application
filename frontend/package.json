    "@tanstack/react-router": "^1.31.26",
    "@tanstack/react-table": "^8.11.7",
    "@tanstack/router-vite-plugin": "^1.15.4",
    "axios": "^1.7.1",
    "ckeditor5": "^43.3.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
