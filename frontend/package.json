{
  "name": "nrl-internal-forms-frontend",
  "author": "SST Digital Tech",
  "description": "One stop solution for all the form based applications",
  "keywords": [
    "vite",
    "react",
    "boilerplate",
    "starter",
    "template"
  ],
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "git init && husky install",
    "format": "biome format ./src --write",
    "lint": "biome lint ./src",
    "lint:fix": "biome check --apply ./src",
    "dev": "vite",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build  --docs",
    "test": "vitest run src/",
    "test:unit": "vitest src/",
    "test:unit:coverage": "vitest --coverage src/",
    "build": "tsc && vite build && npm run storybook:build",
    "build:no-ts": "vite build && npm run storybook:build",
    "preview": "vite preview",
    "commitlint": "commitlint --edit",
    "commitizen": "exec < /dev/tty && git cz --hook || true",
    "cypress": "cypress open",
    "generate": "plop",
    "routes": "tsr generate",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.2.4",
